# ============================================================================
# Agent Runtime 环境配置示例 —— 复制为 .env 后按需修改。
# 注意：.env 不应提交到版本库（已在 .gitignore 中忽略）。
# 默认 mock-first：不填任何 Key 也可运行全部测试与实验。
# ============================================================================

# ---- LLM Provider ----------------------------------------------------------
# 可选值: mock | openai
AGENT_LLM_PROVIDER=mock
# 仅当 provider=openai 时需要（OpenAI 兼容接口）
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://api.openai.com/v1
AGENT_LLM_MODEL=gpt-4o-mini
AGENT_LLM_TEMPERATURE=0.0
AGENT_LLM_MAX_TOKENS=1024

# ---- Embedding Provider -----------------------------------------------------
# 可选值: mock | sentence-transformers | openai
AGENT_EMBEDDING_PROVIDER=mock
AGENT_EMBEDDING_MODEL=all-MiniLM-L6-v2
AGENT_EMBEDDING_DIM=256

# ---- Vector Backend ---------------------------------------------------------
# 可选值: numpy | hnswlib | faiss
AGENT_VECTOR_BACKEND=numpy

# ---- Reproducibility --------------------------------------------------------
AGENT_RANDOM_SEED=42

# ---- Storage ----------------------------------------------------------------
# 运行期数据根目录（artifact / memory / state / results）
AGENT_DATA_DIR=.agent_data

# ---- Sandbox ----------------------------------------------------------------
# 可选值: subprocess | cgroup | podman （不可用时自动降级到 subprocess）
AGENT_SANDBOX_BACKEND=subprocess
AGENT_SANDBOX_TIMEOUT_SEC=10
AGENT_SANDBOX_MEM_MB=256
AGENT_SANDBOX_CPU_SEC=8
AGENT_SANDBOX_NETWORK=disabled

# ---- Observability ----------------------------------------------------------
AGENT_LOG_LEVEL=INFO
AGENT_LOG_FORMAT=json
